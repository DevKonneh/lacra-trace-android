<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
        LACRA Trace system-level colours (splash, system bars, launcher, notifications).
        Compose UI colours live in presentation/ui/theme/Palette.kt - keep both in sync.

        Derived from the official LACRA logo (leaf green, cocoa-pod gold, bean brown).
        Not an official brand manual: replace with official values if LACRA publishes them.
    -->
    <color name="brand_green">#FF226C13</color>
    <color name="brand_green_light">#FF30BF16</color>
    <color name="brand_green_dark">#FF14400B</color>
    <color name="brand_green_tint">#FFE9F5E5</color>
    <color name="brand_gold">#FFF8D92E</color>
    <color name="brand_gold_dark">#FF7A6200</color>
    <color name="brand_brown">#FF4A2D13</color>

    <!-- Semantic roles -->
    <color name="splash_background">@color/brand_green</color>
    <color name="launcher_background">@color/brand_green</color>
    <color name="notification_accent">@color/brand_green</color>
    <color name="system_bar">#FFFFFFFF</color>
    <color name="window_background">#FFFFFFFF</color>

    <!-- Neutrals -->
    <color name="black">#FF000000</color>
    <color name="white">#FFFFFFFF</color>
    <color name="gray">#FF757575</color>
    <color name="light_gray">#FFEEEEEE</color>
    <color name="transparent">#00000000</color>
</resources>
